{
  "name": "quickprompt-mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for Quick Prompt - AI-assisted prompt management, version history, and privacy protection",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "dev": "tsc && node dist/index.js",
    "clean": "rm -rf dist",
    "test": "jest --runInBand"
  },
  "keywords": [
    "mcp",
    "quickprompt",
    "vscode",
    "ai-assistant",
    "prompt-management",
    "privacy"
  ],
  "author": "winterdrive",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
