{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": [
            "ES2020",
            "ES2024",
            "DOM"
        ],
        "types": [
            "node",
            "vscode"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/test",
        "node_modules"
    ]
}