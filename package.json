{
    "name": "quick-prompt",
    "displayName": "%extension.displayName%",
    "description": "%extension.description%",
    "version": "0.3.7",
    "publisher": "winterdrive",
    "icon": "docs/assets/quickprompt_icon_128.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/winterdrive/QuickPrompt"
    },
    "bugs": {
        "url": "https://github.com/winterdrive/QuickPrompt/issues"
    },
    "homepage": "https://github.com/winterdrive/QuickPrompt#readme",
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "clipboard manager",
        "prompt engineering",
        "history",
        "clipboard tool",
        "snippet manager",
        "prompt",
        "ai",
        "copilot",
        "chatgpt",
        "claude",
        "gemini",
        "prompt management",
        "prompt library",
        "prompt snippet",
        "ai assistant",
        "llm",
        "productivity",
        "code assistant",
        "developer tools",
        "clipboard history"
    ],
    "engines": {
        "vscode": "^1.79.0"
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "Quick Prompt",
            "properties": {
                "quickPrompt.clipboardHistory.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable automatic clipboard history tracking"
                },
                "quickPrompt.clipboardHistory.maxItems": {
                    "type": "number",
                    "default": 20,
                    "minimum": 5,
                    "maximum": 100,
                    "description": "Maximum number of clipboard history items to keep"
                },
                "quickPrompt.clipboardHistory.enablePolling": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable lightweight polling (only when VSCode is active)"
                },
                "quickPrompt.clipboardHistory.pollingInterval": {
                    "type": "number",
                    "default": 5000,
                    "minimum": 2000,
                    "maximum": 30000,
                    "description": "Polling interval in milliseconds (5000-10000 recommended)"
                },
                "quickPrompt.clipboardHistory.minLength": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Minimum content length (characters) to record"
                },
                "quickPrompt.ai.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.ai.enabled.description%"
                },
                "quickPrompt.ai.provider": {
                    "type": "string",
                    "enum": ["local-qwen", "openai-compatible"],
                    "default": "local-qwen",
                    "enumDescriptions": [
                        "%config.ai.provider.localQwen%",
                        "%config.ai.provider.openaiCompatible%"
                    ],
                    "description": "%config.ai.provider.description%",
                    "when": "config.quickPrompt.ai.enabled"
                },
                "quickPrompt.ai.openaiCompatible.endpoint": {
                    "type": "string",
                    "default": "http://localhost:11434/v1",
                    "description": "%config.ai.openaiCompatible.endpoint.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.model": {
                    "type": "string",
                    "default": "qwen2.5:0.5b",
                    "description": "%config.ai.openaiCompatible.model.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "%config.ai.openaiCompatible.apiKey.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.timeout": {
                    "type": "number",
                    "default": 15000,
                    "minimum": 3000,
                    "maximum": 60000,
                    "description": "%config.ai.openaiCompatible.timeout.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.features.titleGeneration": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.ai.features.titleGeneration.description%",
                    "when": "config.quickPrompt.ai.enabled"
                },
                "quickPrompt.confirmBeforeDelete": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.confirmBeforeDelete.description%"
                },
                "quickPrompt.privacy.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable privacy protection features (auto-mask sensitive information)"
                },
                "quickPrompt.privacy.autoMask": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically mask sensitive information when copying text"
                },
                "quickPrompt.privacy.patterns.email": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable email address masking"
                },
                "quickPrompt.privacy.patterns.phone": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable phone number masking"
                },
                "quickPrompt.privacy.patterns.idCard": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Taiwan ID card number masking"
                },
                "quickPrompt.privacy.patterns.apiKeys": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable API key masking (AWS, GitHub, OpenAI, etc.)"
                },
                "quickPrompt.privacy.patterns.creditCard": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable credit card number masking (disabled by default to avoid false positives)"
                },
                "quickPrompt.privacy.patterns.ipAddress": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable IP address masking"
                },
                "quickPrompt.privacy.patterns.privateKey": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable private key masking"
                },
                "quickPrompt.privacy.ui.showNotification": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show popup notification when sensitive information is masked (status bar message is always shown)"
                },
                "quickPrompt.privacy.ui.maskLabel": {
                    "type": "string",
                    "default": "[MASKED]",
                    "description": "Default mask label format"
                },
                "quickPrompt.privacy.ui.highlightColor": {
                    "type": "string",
                    "default": "#ff6b6b",
                    "description": "Color for highlighting masked items in preview"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "promptSniperContainer",
                    "title": "%view.container.title%",
                    "icon": "docs/assets/quickprompt_icon_gray.svg"
                }
            ]
        },
        "views": {
            "promptSniperContainer": [
                {
                    "id": "promptSniperView",
                    "name": "%view.prompts.name%",
                    "icon": "$(list-unordered)"
                },
                {
                    "id": "clipboardHistoryView",
                    "name": "%view.clipboard.name%",
                    "icon": "$(clippy)",
                    "when": "config.quickPrompt.clipboardHistory.enabled"
                },
                {
                    "id": "sessionHandoffView",
                    "name": "Edo Tensei Sessions",
                    "icon": "$(archive)"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "sessionHandoffView",
                "contents": "Ready for Edo Tensei?\n\n[Fetch ALL Historical Sessions](command:edoTensei.fetchAllSessions)"
            }
        ],
        "commands": [
            {
                "command": "promptSniper.search",
                "title": "%command.search.title%",
                "icon": "$(search)"
            },
            {
                "command": "promptSniper.insert",
                "title": "%command.insert.title%",
                "icon": "$(copy)"
            },
            {
                "command": "promptSniper.addPrompt",
                "title": "%command.addPrompt.title%",
                "icon": "$(add)"
            },
            {
                "command": "promptSniper.addPromptWithTitle",
                "title": "%command.addPromptWithTitle.title%",
                "icon": "$(add)"
            },
            {
                "command": "promptSniper.silentAdd",
                "title": "%command.silentAdd.title%",
                "icon": "$(zap)"
            },
            {
                "command": "promptSniper.deletePrompt",
                "title": "%command.deletePrompt.title%",
                "icon": "$(trash)"
            },
            {
                "command": "promptSniper.togglePin",
                "title": "%command.togglePin.title%",
                "icon": "$(pin)"
            },
            {
                "command": "promptSniper.refresh",
                "title": "%command.refresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "promptSniper.editPrompt",
                "title": "%command.editPrompt.title%",
                "icon": "$(edit)"
            },
            {
                "command": "promptSniper.copyClipboardItem",
                "title": "%command.copyClipboardItem.title%",
                "icon": "$(copy)"
            },
            {
                "command": "promptSniper.pinClipboardItem",
                "title": "%command.pinClipboardItem.title%",
                "icon": "$(pin)"
            },
            {
                "command": "promptSniper.editClipboardItem",
                "title": "%command.editClipboardItem.title%",
                "icon": "$(edit)"
            },
            {
                "command": "promptSniper.removeClipboardItem",
                "title": "%command.removeClipboardItem.title%",
                "icon": "$(trash)"
            },
            {
                "command": "promptSniper.clearClipboardHistory",
                "title": "%command.clearClipboardHistory.title%",
                "icon": "$(clear-all)"
            },
            {
                "command": "promptSniper.moveUp",
                "title": "%command.moveUp.title%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "promptSniper.moveDown",
                "title": "%command.moveDown.title%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "promptSniper.clearModelCache",
                "title": "%command.clearModelCache.title%",
                "category": "Quick Prompt",
                "icon": "$(trash)"
            },
            {
                "command": "quickPrompt.testAIConnection",
                "title": "%command.testAIConnection.title%",
                "category": "Quick Prompt",
                "icon": "$(plug)"
            },
            {
                "command": "promptSniper.showVersionDiff",
                "title": "%command.showVersionDiff.title%",
                "icon": "$(diff)"
            },
            {
                "command": "promptSniper.applyVersion",
                "title": "%command.applyVersion.title%",
                "icon": "$(history)"
            },
            {
                "command": "promptSniper.tagMilestone",
                "title": "%command.tagMilestone.title%",
                "icon": "$(tag)"
            },
            {
                "command": "promptSniper.renameMilestone",
                "title": "%command.renameMilestone.title%",
                "icon": "$(edit)"
            },
            {
                "command": "promptSniper.removeMilestone",
                "title": "%command.removeMilestone.title%",
                "icon": "$(close)"
            },
            {
                "command": "promptSniper.deleteVersion",
                "title": "%command.deleteVersion.title%",
                "icon": "$(trash)"
            },
            {
                "command": "promptSniper.copyVersionContent",
                "title": "%command.copyVersionContent.title%",
                "icon": "$(copy)"
            },
            {
                "command": "quickPrompt.showMcpConfig",
                "title": "Show MCP Config",
                "category": "Quick Prompt",
                "icon": "$(server-environment)"
            },
            {
                "command": "quickPrompt.generateSkill",
                "title": "Generate Skill File",
                "category": "Quick Prompt",
                "icon": "$(file-code)"
            },
            {
                "command": "promptSniper.maskPrompt",
                "title": "Mask Prompt",
                "icon": "$(shield)"
            },
            {
                "command": "promptSniper.unmaskPrompt",
                "title": "Unmask Prompt",
                "icon": "$(unlock)"
            },
            {
                "command": "promptSniper.ignorePromptWarning",
                "title": "Ignore Privacy Warning",
                "icon": "$(close)"
            },
            {
                "command": "promptSniper.restorePromptWarning",
                "title": "Restore Privacy Warning",
                "icon": "$(eye)"
            },
            {
                "command": "edoTensei.sealSession",
                "title": "Edo Tensei: Seal Session",
                "category": "Edo Tensei",
                "icon": "$(archive)"
            },
            {
                "command": "edoTensei.resurrectSession",
                "title": "Edo Tensei: Resurrect Session",
                "category": "Edo Tensei",
                "icon": "$(sparkle)"
            },
            {
                "command": "edoTensei.copyHandoffPrompt",
                "title": "Edo Tensei: Copy Handoff Prompt",
                "category": "Edo Tensei",
                "icon": "$(copy)"
            },
            {
                "command": "edoTensei.openSessionFile",
                "title": "Edo Tensei: Open Session File",
                "category": "Edo Tensei",
                "icon": "$(file-code)"
            },
            {
                "command": "edoTensei.scanSessions",
                "title": "Scan Project Sessions",
                "category": "Edo Tensei",
                "icon": "$(search)"
            },
            {
                "command": "edoTensei.fetchAllSessions",
                "title": "Fetch ALL Historical Sessions",
                "category": "Edo Tensei",
                "icon": "$(history)"
            },
            {
                "command": "edoTensei.exportAllSessions",
                "title": "Export All Sessions to .edo_tensei",
                "category": "Edo Tensei",
                "icon": "$(save-all)"
            }
        ],
        "keybindings": [
            {
                "command": "promptSniper.search",
                "key": "alt+p",
                "mac": "opt+p"
            },
            {
                "command": "promptSniper.silentAdd",
                "key": "alt+shift+s",
                "mac": "opt+shift+s"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "promptSniper.search",
                    "when": "view == promptSniperView",
                    "group": "navigation@0"
                },
                {
                    "command": "promptSniper.addPrompt",
                    "when": "view == promptSniperView",
                    "group": "navigation@1"
                },
                {
                    "command": "quickPrompt.showMcpConfig",
                    "when": "view == promptSniperView",
                    "group": "navigation@2"
                },
                {
                    "command": "quickPrompt.generateSkill",
                    "when": "view == promptSniperView",
                    "group": "navigation@3"
                },
                {
                    "command": "promptSniper.refresh",
                    "when": "view == promptSniperView",
                    "group": "navigation@4"
                },
                {
                    "command": "promptSniper.clearClipboardHistory",
                    "when": "view == clipboardHistoryView",
                    "group": "navigation@1"
                },
                {
                    "command": "edoTensei.scanSessions",
                    "when": "view == sessionHandoffView",
                    "group": "navigation@1"
                },
                {
                    "command": "edoTensei.fetchAllSessions",
                    "when": "view == sessionHandoffView",
                    "group": "navigation@2"
                },
                {
                    "command": "edoTensei.exportAllSessions",
                    "when": "view == sessionHandoffView",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "promptSniper.insert",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "inline@1"
                },
                {
                    "command": "promptSniper.togglePin",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "inline@2"
                },
                {
                    "command": "promptSniper.editPrompt",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "inline@3"
                },
                {
                    "command": "promptSniper.deletePrompt",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "inline@4"
                },
                {
                    "command": "promptSniper.moveUp",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "navigation@1"
                },
                {
                    "command": "promptSniper.moveDown",
                    "when": "view == promptSniperView && viewItem =~ /^promptItem/",
                    "group": "navigation@2"
                },
                {
                    "command": "promptSniper.copyClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@1"
                },
                {
                    "command": "promptSniper.pinClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@2"
                },
                {
                    "command": "promptSniper.editClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@3"
                },
                {
                    "command": "promptSniper.removeClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@4"
                },
                {
                    "command": "promptSniper.tagMilestone",
                    "when": "view == promptSniperView && viewItem == versionItem:current",
                    "group": "inline@1"
                },
                {
                    "command": "promptSniper.renameMilestone",
                    "when": "view == promptSniperView && viewItem == versionItem:milestone",
                    "group": "inline@2"
                },
                {
                    "command": "promptSniper.copyVersionContent",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(current|history|milestone)/",
                    "group": "inline@3"
                },
                {
                    "command": "promptSniper.applyVersion",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "1_actions@1"
                },
                {
                    "command": "promptSniper.tagMilestone",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(history|current)/",
                    "group": "1_actions@2"
                },
                {
                    "command": "promptSniper.renameMilestone",
                    "when": "view == promptSniperView && viewItem == versionItem:milestone",
                    "group": "1_actions@2"
                },
                {
                    "command": "promptSniper.copyVersionContent",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(current|history|milestone)/",
                    "group": "1_actions@3"
                },
                {
                    "command": "promptSniper.showVersionDiff",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "2_view@1"
                },
                {
                    "command": "promptSniper.removeMilestone",
                    "when": "view == promptSniperView && viewItem == versionItem:milestone",
                    "group": "2_view@2"
                },
                {
                    "command": "promptSniper.deleteVersion",
                    "when": "view == promptSniperView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "9_danger@1"
                },
                {
                    "command": "promptSniper.maskPrompt",
                    "when": "view == promptSniperView && viewItem == promptItem_maskable",
                    "group": "3_privacy@1"
                },
                {
                    "command": "promptSniper.ignorePromptWarning",
                    "when": "view == promptSniperView && viewItem == promptItem_maskable",
                    "group": "3_privacy@2"
                },
                {
                    "command": "promptSniper.restorePromptWarning",
                    "when": "view == promptSniperView && viewItem == promptItem_ignored",
                    "group": "3_privacy@2"
                },
                {
                    "command": "promptSniper.unmaskPrompt",
                    "when": "view == promptSniperView && viewItem == promptItem_protected",
                    "group": "3_privacy@1"
                },
                {
                    "command": "edoTensei.copyHandoffPrompt",
                    "when": "view == sessionHandoffView && viewItem == sessionItem",
                    "group": "inline@2"
                }
            ],
            "editor/context": [
                {
                    "command": "promptSniper.silentAdd",
                    "when": "editorHasSelection",
                    "group": "promptSniper@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:qp && npm run build:mcp && tsc -p ./",
        "build:qp": "node node_modules/esbuild/bin/esbuild qp-entry.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/qp.bundle.js --external:vscode",
        "build:mcp": "node node_modules/esbuild/bin/esbuild mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp/index.js --external:vscode",
        "build:mcp:watch": "node node_modules/esbuild/bin/esbuild mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp/index.js --external:vscode --watch"
    },
    "devDependencies": {
        "@types/node": "^16.x",
        "@types/vscode": "^1.75.0",
        "esbuild": "^0.24.0",
        "typescript": "^4.9.5"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.27.1",
        "zod": "^3.23.8"
    }
}
