{
    "name": "quick-prompt",
    "displayName": "Quick Prompt - Capture Ideas & Queue Tasks While AI Works",
    "description": "%extension.description%",
    "version": "0.5.4",
    "publisher": "winterdrive",
    "icon": "docs/assets/quickprompt_icon_128.png",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/winterdrive/vscode-quick-prompt"
    },
    "bugs": {
        "url": "https://github.com/winterdrive/vscode-quick-prompt/issues"
    },
    "homepage": "https://github.com/winterdrive/vscode-quick-prompt#readme",
    "categories": [
        "Other",
        "Snippets"
    ],
    "keywords": [
        "clipboard manager",
        "prompt engineering",
        "history",
        "clipboard tool",
        "snippet manager",
        "prompt",
        "ai",
        "copilot",
        "chatgpt",
        "claude",
        "gemini",
        "prompt management",
        "prompt library",
        "prompt snippet",
        "ai assistant",
        "llm",
        "productivity",
        "code assistant",
        "developer tools",
        "clipboard history"
    ],
    "engines": {
        "vscode": "^1.79.0"
    },
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "contributes": {
        "configuration": {
            "title": "Quick Prompt",
            "properties": {
                "quickPrompt.clipboardHistory.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable automatic clipboard history tracking"
                },
                "quickPrompt.clipboardHistory.maxItems": {
                    "type": "number",
                    "default": 20,
                    "minimum": 5,
                    "maximum": 100,
                    "description": "Maximum number of clipboard history items to keep"
                },
                "quickPrompt.clipboardHistory.enablePolling": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable lightweight polling (only when VSCode is active)"
                },
                "quickPrompt.clipboardHistory.pollingInterval": {
                    "type": "number",
                    "default": 5000,
                    "minimum": 2000,
                    "maximum": 30000,
                    "description": "Polling interval in milliseconds (5000-10000 recommended)"
                },
                "quickPrompt.clipboardHistory.minLength": {
                    "type": "number",
                    "default": 10,
                    "minimum": 1,
                    "maximum": 100,
                    "description": "Minimum content length (characters) to record"
                },
                "quickPrompt.ai.enabled": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.ai.enabled.description%"
                },
                "quickPrompt.ai.provider": {
                    "type": "string",
                    "enum": [
                        "local-qwen",
                        "openai-compatible"
                    ],
                    "default": "local-qwen",
                    "enumDescriptions": [
                        "%config.ai.provider.localQwen%",
                        "%config.ai.provider.openaiCompatible%"
                    ],
                    "description": "%config.ai.provider.description%",
                    "when": "config.quickPrompt.ai.enabled"
                },
                "quickPrompt.ai.localModel": {
                    "type": "string",
                    "enum": [
                        "smollm2-135m",
                        "smollm2-360m",
                        "qwen3-0.6b"
                    ],
                    "default": "qwen3-0.6b",
                    "enumDescriptions": [
                        "%config.ai.localModel.smollm2135m%",
                        "%config.ai.localModel.smollm2360m%",
                        "%config.ai.localModel.qwen3%"
                    ],
                    "description": "%config.ai.localModel.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == local-qwen"
                },
                "quickPrompt.ai.openaiCompatible.endpoint": {
                    "type": "string",
                    "default": "http://localhost:11434/v1",
                    "description": "%config.ai.openaiCompatible.endpoint.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.model": {
                    "type": "string",
                    "default": "qwen2.5:0.5b",
                    "description": "%config.ai.openaiCompatible.model.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "%config.ai.openaiCompatible.apiKey.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.openaiCompatible.timeout": {
                    "type": "number",
                    "default": 15000,
                    "minimum": 3000,
                    "maximum": 60000,
                    "description": "%config.ai.openaiCompatible.timeout.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == openai-compatible"
                },
                "quickPrompt.ai.enableThinking": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.ai.enableThinking.description%",
                    "when": "config.quickPrompt.ai.enabled && config.quickPrompt.ai.provider == local-qwen"
                },
                "quickPrompt.ai.features.titleGeneration": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.ai.features.titleGeneration.description%",
                    "when": "config.quickPrompt.ai.enabled"
                },
                "quickPrompt.confirmBeforeDelete": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.confirmBeforeDelete.description%"
                },
                "quickPrompt.privacy.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable privacy protection features (auto-mask sensitive information)"
                },
                "quickPrompt.privacy.autoMask": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically mask sensitive information when copying text"
                },
                "quickPrompt.privacy.patterns.email": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable email address masking"
                },
                "quickPrompt.privacy.patterns.phone": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable phone number masking"
                },
                "quickPrompt.privacy.patterns.idCard": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable Taiwan ID card number masking"
                },
                "quickPrompt.privacy.patterns.apiKeys": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable API key masking (AWS, GitHub, OpenAI, etc.)"
                },
                "quickPrompt.privacy.patterns.creditCard": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable credit card number masking (disabled by default to avoid false positives)"
                },
                "quickPrompt.privacy.patterns.ipAddress": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable IP address masking"
                },
                "quickPrompt.privacy.patterns.privateKey": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable private key masking"
                },
                "quickPrompt.privacy.ui.showNotification": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show popup notification when sensitive information is masked (status bar message is always shown)"
                },
                "quickPrompt.privacy.ui.maskLabel": {
                    "type": "string",
                    "default": "[MASKED]",
                    "description": "Default mask label format"
                },
                "quickPrompt.privacy.ui.highlightColor": {
                    "type": "string",
                    "default": "#ff6b6b",
                    "description": "Color for highlighting masked items in preview"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "quickPromptContainer",
                    "title": "%view.container.title%",
                    "icon": "docs/assets/quickprompt_icon_gray.svg"
                }
            ]
        },
        "views": {
            "quickPromptContainer": [
                {
                    "id": "quickPromptView",
                    "name": "%view.prompts.name%",
                    "icon": "$(list-unordered)"
                },
                {
                    "id": "clipboardHistoryView",
                    "name": "%view.clipboard.name%",
                    "icon": "$(clippy)",
                    "when": "config.quickPrompt.clipboardHistory.enabled"
                }
            ]
        },
        "commands": [
            {
                "command": "quickPrompt.search",
                "title": "%command.search.title%",
                "icon": "$(search)"
            },
            {
                "command": "quickPrompt.insert",
                "title": "%command.insert.title%",
                "icon": "$(copy)"
            },
            {
                "command": "quickPrompt.addPrompt",
                "title": "%command.addPrompt.title%",
                "icon": "$(add)"
            },
            {
                "command": "quickPrompt.addPromptWithTitle",
                "title": "%command.addPromptWithTitle.title%",
                "icon": "$(add)"
            },
            {
                "command": "quickPrompt.silentAdd",
                "title": "%command.silentAdd.title%",
                "icon": "$(zap)"
            },
            {
                "command": "quickPrompt.deletePrompt",
                "title": "%command.deletePrompt.title%",
                "icon": "$(trash)"
            },
            {
                "command": "quickPrompt.togglePin",
                "title": "%command.togglePin.title%",
                "icon": "$(pin)"
            },
            {
                "command": "quickPrompt.refresh",
                "title": "%command.refresh.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "quickPrompt.editPrompt",
                "title": "%command.editPrompt.title%",
                "icon": "$(edit)"
            },
            {
                "command": "quickPrompt.renamePrompt",
                "title": "%command.renamePrompt.title%",
                "icon": "$(tag)"
            },
            {
                "command": "quickPrompt.copyClipboardItem",
                "title": "%command.copyClipboardItem.title%",
                "icon": "$(copy)"
            },
            {
                "command": "quickPrompt.pinClipboardItem",
                "title": "%command.pinClipboardItem.title%",
                "icon": "$(pin)"
            },
            {
                "command": "quickPrompt.viewClipboardItem",
                "title": "%command.viewClipboardItem.title%",
                "icon": "$(open-preview)"
            },
            {
                "command": "quickPrompt.removeClipboardItem",
                "title": "%command.removeClipboardItem.title%",
                "icon": "$(trash)"
            },
            {
                "command": "quickPrompt.clearClipboardHistory",
                "title": "%command.clearClipboardHistory.title%",
                "icon": "$(clear-all)"
            },
            {
                "command": "quickPrompt.refreshClipboard",
                "title": "%command.refreshClipboard.title%",
                "icon": "$(refresh)"
            },
            {
                "command": "quickPrompt.moveUp",
                "title": "%command.moveUp.title%",
                "icon": "$(arrow-up)"
            },
            {
                "command": "quickPrompt.moveDown",
                "title": "%command.moveDown.title%",
                "icon": "$(arrow-down)"
            },
            {
                "command": "quickPrompt.clearModelCache",
                "title": "%command.clearModelCache.title%",
                "category": "Quick Prompt",
                "icon": "$(trash)"
            },
            {
                "command": "quickPrompt.testAIConnection",
                "title": "%command.testAIConnection.title%",
                "category": "Quick Prompt",
                "icon": "$(plug)"
            },
            {
                "command": "quickPrompt.showVersionDiff",
                "title": "%command.showVersionDiff.title%",
                "icon": "$(diff)"
            },
            {
                "command": "quickPrompt.applyVersion",
                "title": "%command.applyVersion.title%",
                "icon": "$(history)"
            },
            {
                "command": "quickPrompt.tagMilestone",
                "title": "%command.tagMilestone.title%",
                "icon": "$(tag)"
            },
            {
                "command": "quickPrompt.renameMilestone",
                "title": "%command.renameMilestone.title%",
                "icon": "$(edit)"
            },
            {
                "command": "quickPrompt.removeMilestone",
                "title": "%command.removeMilestone.title%",
                "icon": "$(close)"
            },
            {
                "command": "quickPrompt.deleteVersion",
                "title": "%command.deleteVersion.title%",
                "icon": "$(trash)"
            },
            {
                "command": "quickPrompt.copyVersionContent",
                "title": "%command.copyVersionContent.title%",
                "icon": "$(copy)"
            },
            {
                "command": "quickPrompt.showMcpConfig",
                "title": "Show MCP Config",
                "category": "Quick Prompt",
                "icon": "$(gear)"
            },
            {
                "command": "quickPrompt.generateSkill",
                "title": "Generate Skill File",
                "category": "Quick Prompt",
                "icon": "$(file-code)"
            },
            {
                "command": "quickPrompt.maskPrompt",
                "title": "Mask Prompt",
                "icon": "$(shield)"
            },
            {
                "command": "quickPrompt.unmaskPrompt",
                "title": "Unmask Prompt",
                "icon": "$(unlock)"
            },
            {
                "command": "quickPrompt.ignorePromptWarning",
                "title": "Ignore Privacy Warning",
                "icon": "$(close)"
            },
            {
                "command": "quickPrompt.restorePromptWarning",
                "title": "Restore Privacy Warning",
                "icon": "$(eye)"
            }
        ],
        "keybindings": [
            {
                "command": "quickPrompt.search",
                "key": "alt+p",
                "mac": "opt+p"
            },
            {
                "command": "quickPrompt.silentAdd",
                "key": "alt+shift+s",
                "mac": "opt+shift+s"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "quickPrompt.search",
                    "when": "view == quickPromptView",
                    "group": "navigation@0"
                },
                {
                    "command": "quickPrompt.addPrompt",
                    "when": "view == quickPromptView",
                    "group": "navigation@1"
                },
                {
                    "command": "quickPrompt.showMcpConfig",
                    "when": "view == quickPromptView",
                    "group": "navigation@2"
                },
                {
                    "command": "quickPrompt.generateSkill",
                    "when": "view == quickPromptView",
                    "group": "navigation@3"
                },
                {
                    "command": "quickPrompt.refresh",
                    "when": "view == quickPromptView",
                    "group": "navigation@4"
                },
                {
                    "command": "quickPrompt.refreshClipboard",
                    "when": "view == clipboardHistoryView",
                    "group": "navigation@0"
                },
                {
                    "command": "quickPrompt.clearClipboardHistory",
                    "when": "view == clipboardHistoryView",
                    "group": "navigation@1"
                }
            ],
            "view/item/context": [
                {
                    "command": "quickPrompt.insert",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "inline@1"
                },
                {
                    "command": "quickPrompt.togglePin",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "inline@2"
                },
                {
                    "command": "quickPrompt.deletePrompt",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "inline@3"
                },
                {
                    "command": "quickPrompt.renamePrompt",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "1_actions@1"
                },
                {
                    "command": "quickPrompt.moveUp",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "navigation@1"
                },
                {
                    "command": "quickPrompt.moveDown",
                    "when": "view == quickPromptView && viewItem =~ /^promptItem/",
                    "group": "navigation@2"
                },
                {
                    "command": "quickPrompt.copyClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@1"
                },
                {
                    "command": "quickPrompt.pinClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@2"
                },
                {
                    "command": "quickPrompt.removeClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "inline@3"
                },
                {
                    "command": "quickPrompt.viewClipboardItem",
                    "when": "view == clipboardHistoryView && viewItem == clipboardItem",
                    "group": "1_actions@1"
                },
                {
                    "command": "quickPrompt.tagMilestone",
                    "when": "view == quickPromptView && viewItem == versionItem:current",
                    "group": "inline@1"
                },
                {
                    "command": "quickPrompt.renameMilestone",
                    "when": "view == quickPromptView && viewItem == versionItem:milestone",
                    "group": "inline@2"
                },
                {
                    "command": "quickPrompt.copyVersionContent",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(current|history|milestone)/",
                    "group": "inline@3"
                },
                {
                    "command": "quickPrompt.applyVersion",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "1_actions@1"
                },
                {
                    "command": "quickPrompt.tagMilestone",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(history|current)/",
                    "group": "1_actions@2"
                },
                {
                    "command": "quickPrompt.renameMilestone",
                    "when": "view == quickPromptView && viewItem == versionItem:milestone",
                    "group": "1_actions@2"
                },
                {
                    "command": "quickPrompt.copyVersionContent",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(current|history|milestone)/",
                    "group": "1_actions@3"
                },
                {
                    "command": "quickPrompt.showVersionDiff",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "2_view@1"
                },
                {
                    "command": "quickPrompt.removeMilestone",
                    "when": "view == quickPromptView && viewItem == versionItem:milestone",
                    "group": "2_view@2"
                },
                {
                    "command": "quickPrompt.deleteVersion",
                    "when": "view == quickPromptView && viewItem =~ /versionItem:(history|milestone)/",
                    "group": "9_danger@1"
                },
                {
                    "command": "quickPrompt.maskPrompt",
                    "when": "view == quickPromptView && viewItem == promptItem_maskable",
                    "group": "3_privacy@1"
                },
                {
                    "command": "quickPrompt.ignorePromptWarning",
                    "when": "view == quickPromptView && viewItem == promptItem_maskable",
                    "group": "3_privacy@2"
                },
                {
                    "command": "quickPrompt.restorePromptWarning",
                    "when": "view == quickPromptView && viewItem == promptItem_ignored",
                    "group": "3_privacy@2"
                },
                {
                    "command": "quickPrompt.unmaskPrompt",
                    "when": "view == quickPromptView && viewItem == promptItem_protected",
                    "group": "3_privacy@1"
                }
            ],
            "editor/context": [
                {
                    "command": "quickPrompt.silentAdd",
                    "when": "editorHasSelection",
                    "group": "quickPrompt@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:qp && npm run build:mcp && tsc -p ./ && npm run build:skills",
        "build": "npm run clean && tsc -p ./ && npm run build:qp && npm run build:mcp && npm run build:skills",
        "build:skills": "node -e \"const fs=require('fs');fs.mkdirSync('dist/skills/quickprompt',{recursive:true});fs.copyFileSync('skills/quickprompt/SKILL.md','dist/skills/quickprompt/SKILL.md');fs.mkdirSync('skills/quickprompt/scripts',{recursive:true});fs.copyFileSync('dist/qp.bundle.js','skills/quickprompt/scripts/qp.bundle.js')\"",
        "_trigger_publish": "echo 'Triggering publish workflow'",
        "build:qp": "esbuild qp-entry.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/qp.bundle.js --external:vscode",
        "build:mcp": "esbuild mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp/index.js --external:vscode",
        "build:mcp:watch": "esbuild mcp-server/src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/mcp/index.js --external:vscode --watch",
        "test": "jest --runInBand",
        "test:coverage": "jest --runInBand --coverage",
        "test:watch": "jest --watch",
        "test:ui:setup": "extest setup-tests",
        "test:ui": "tsc -p tsconfig.test.ui.json && extest setup-and-run \"out/test/ui/**/*.test.js\" -e \".vscode-test/extensions\""
    },
    "devDependencies": {
        "@types/chai": "^5.2.3",
        "@types/jest": "^29.5.14",
        "@types/mocha": "^10.0.10",
        "@types/node": "^16.x",
        "@types/vscode": "^1.75.0",
        "chai": "^4.5.0",
        "esbuild": "^0.28.1",
        "fast-check": "^4.8.0",
        "jest": "^29.7.0",
        "mocha": "^10.8.2",
        "ts-jest": "^29.4.9",
        "typescript": "^5.9.3",
        "vscode-extension-tester": "^8.23.0"
    },
    "dependencies": {
        "@huggingface/transformers": "^3.0.0",
        "@modelcontextprotocol/sdk": "^1.27.1",
        "zod": "^3.23.8"
    },
    "overrides": {
        "serialize-javascript": "^7.0.5"
    }
}
